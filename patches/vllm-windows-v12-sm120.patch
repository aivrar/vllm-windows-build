--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -16,6 +16,37 @@ project(vllm_extensions LANGUAGES CXX)
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CUDA_STANDARD 20)
+
+# Windows/MSVC opt-in switches for native SM120 (Blackwell) FP8/NVFP4 CUTLASS kernels (see docs/blackwell-sm120.md).
+# Both are OFF unless the environment variable is 1/ON/TRUE/YES, so default builds are unchanged.
+set(VLLM_WIN_NATIVE_SM120 OFF)
+set(VLLM_WIN_CXX17_CUTLASS OFF)
+if(WIN32)
+  if("$ENV{VLLM_WIN_NATIVE_SM120}" MATCHES "^(1|ON|TRUE|YES)$")
+    set(VLLM_WIN_NATIVE_SM120 ON)
+  endif()
+  if("$ENV{VLLM_WIN_CXX17_CUTLASS}" MATCHES "^(1|ON|TRUE|YES)$")
+    set(VLLM_WIN_CXX17_CUTLASS ON)
+  endif()
+  message(STATUS "Windows opt-ins: VLLM_WIN_NATIVE_SM120=${VLLM_WIN_NATIVE_SM120} VLLM_WIN_CXX17_CUTLASS=${VLLM_WIN_CXX17_CUTLASS}")
+endif()
+# Windows/MSVC + CUDA 13.5: CUTLASS/cute fails to compile in C++20 mode (C3545), while other vLLM sources need C++20
+# (e.g. explicit lambda template parameters). With VLLM_WIN_CXX17_CUTLASS=1 build the CUTLASS-heavy sources as C++17;
+# nvcc takes the last -std.
+if(WIN32 AND VLLM_WIN_CXX17_CUTLASS)
+  file(GLOB_RECURSE _VLLM_WIN_CXX17_SRCS
+       "${CMAKE_CURRENT_SOURCE_DIR}/csrc/quantization/w8a8/cutlass/*.cu"
+       "${CMAKE_CURRENT_SOURCE_DIR}/csrc/quantization/fp4/*.cu"
+       "${CMAKE_CURRENT_SOURCE_DIR}/csrc/quantization/cutlass_w4a8/*.cu"
+       "${CMAKE_CURRENT_SOURCE_DIR}/csrc/sparse/cutlass/*.cu"
+       "${CMAKE_CURRENT_SOURCE_DIR}/csrc/attention/mla/*.cu")
+  set_source_files_properties(${_VLLM_WIN_CXX17_SRCS} PROPERTIES COMPILE_OPTIONS "-std=c++17")
+endif()
+# Windows/MSVC cannot pass 128-byte-aligned by-value kernel parameters (C2719). The CUDA 13.x cuda.h declares
+# CUtensorMap alignas(128) (only 12.6/12.8 use alignas(64)), so allow a patched cuda.h directory to take precedence.
+if(WIN32 AND DEFINED ENV{VLLM_CUDA_SHIM_DIR})
+  set(CMAKE_CUDA_FLAGS "-I$ENV{VLLM_CUDA_SHIM_DIR} ${CMAKE_CUDA_FLAGS}")
+endif()
 set(CMAKE_CUDA_STANDARD_REQUIRED ON)
 set(CMAKE_HIP_STANDARD 20)
 set(CMAKE_HIP_STANDARD_REQUIRED ON)
@@ -635,6 +666,38 @@ if(VLLM_GPU_LANG STREQUAL "CUDA" OR VLLM_GPU_LANG STREQUAL "HIP")
       endif()
     endif()
 
+    # Opt-in native SM120 build: CUTLASS tensor_fill.h uses the NAN macro, which nvcc does not see here.
+    if(MSVC AND VLLM_WIN_NATIVE_SM120 AND EXISTS "${CMAKE_SOURCE_DIR}/cutlass-windows-sm120.patch")
+      execute_process(
+        COMMAND git apply --check "${CMAKE_SOURCE_DIR}/cutlass-windows-sm120.patch"
+        WORKING_DIRECTORY "${cutlass_SOURCE_DIR}"
+        RESULT_VARIABLE _cutlass_sm120_patch_check
+        OUTPUT_QUIET ERROR_QUIET
+      )
+      if(_cutlass_sm120_patch_check EQUAL 0)
+        message(STATUS "Applying cutlass-windows-sm120.patch")
+        execute_process(
+          COMMAND git apply "${CMAKE_SOURCE_DIR}/cutlass-windows-sm120.patch"
+          WORKING_DIRECTORY "${cutlass_SOURCE_DIR}"
+          RESULT_VARIABLE _cutlass_sm120_patch_apply
+        )
+        if(NOT _cutlass_sm120_patch_apply EQUAL 0)
+          message(FATAL_ERROR "Failed to apply cutlass-windows-sm120.patch")
+        endif()
+      else()
+        execute_process(
+          COMMAND git apply --reverse --check "${CMAKE_SOURCE_DIR}/cutlass-windows-sm120.patch"
+          WORKING_DIRECTORY "${cutlass_SOURCE_DIR}"
+          RESULT_VARIABLE _cutlass_sm120_patch_reverse
+          OUTPUT_QUIET ERROR_QUIET
+        )
+        if(NOT _cutlass_sm120_patch_reverse EQUAL 0)
+          message(FATAL_ERROR "cutlass-windows-sm120.patch neither applies nor is already applied")
+        endif()
+        message(STATUS "cutlass-windows-sm120.patch already applied")
+      endif()
+    endif()
+
     list(APPEND VLLM_STABLE_EXT_SRC
       "csrc/quantization/w8a8/cutlass/scaled_mm_entry.cu"
       "csrc/quantization/fp4/nvfp4_quant_entry.cu"
@@ -972,7 +1035,7 @@ if(VLLM_GPU_LANG STREQUAL "CUDA" OR VLLM_GPU_LANG STREQUAL "HIP")
