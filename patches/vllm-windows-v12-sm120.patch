-  if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.8 AND SCALED_MM_ARCHS AND NOT WIN32)
+  if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.8 AND SCALED_MM_ARCHS AND (NOT WIN32 OR VLLM_WIN_NATIVE_SM120))
     set(SCALED_MM_SM120_SRCS
       "csrc/quantization/w8a8/cutlass/scaled_mm_c3x_sm120.cu"
       "csrc/quantization/w8a8/cutlass/c3x/scaled_mm_sm120_fp8.cu"
@@ -1150,7 +1213,7 @@ if(VLLM_GPU_LANG STREQUAL "CUDA" OR VLLM_GPU_LANG STREQUAL "HIP")
   else()
     cuda_archs_loose_intersection(FP4_SM120_ARCHS "12.0a;12.1a" "${CUDA_ARCHS}")
   endif()
-  if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.8 AND FP4_SM120_ARCHS AND NOT WIN32)
+  if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.8 AND FP4_SM120_ARCHS AND (NOT WIN32 OR VLLM_WIN_NATIVE_SM120))
     set(FP4_SM120_SRCS
       "csrc/quantization/fp4/nvfp4_quant_kernels.cu"
       "csrc/quantization/fp4/activation_nvfp4_quant_fusion_kernels.cu"
